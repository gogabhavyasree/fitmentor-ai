<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      body { margin: 0; font-family: Arial, sans-serif; background: #071a2f; color: #eaf7fb; }
      .container { max-width: 900px; margin: 40px auto; }
      .card { background: #102d49; padding: 24px; border-radius: 14px; margin: 18px 0; }
      .badge { background: #1cbf9b; color: #072a2a; padding: 6px 10px; border-radius: 999px; display: inline-block; }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Dashboard</h1>
      <% if (user) { %>
        <div class="card">
          <span class="badge">Logged in</span>
          <h2>Welcome, <%= user.name %>!</h2>
          <p>Goal: <%= user.goal %></p>
        </div>
      <% } else { %>
        <div class="card">
          <p>Please <a href="/login">login</a> to access your dashboard.</p>
        </div>
      <% } %>
    </div>
  </body>
</html>
