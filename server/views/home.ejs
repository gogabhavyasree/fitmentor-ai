<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      body { margin: 0; font-family: Arial, sans-serif; background: #071a2f; color: #eaf7fb; }
      .container { max-width: 900px; margin: 0 auto; padding: 50px 20px; }
      .hero { background: linear-gradient(135deg, #0f2d4d, #0f7a6e); padding: 30px; border-radius: 16px; }
      .nav { display: flex; gap: 16px; margin-bottom: 20px; }
      .nav a { color: #7ef2d4; text-decoration: none; }
      .button { display: inline-block; margin-top: 20px; padding: 12px 18px; background: #23d3a9; color: #041a27; border-radius: 8px; text-decoration: none; font-weight: bold; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="nav">
        <a href="/">Home</a>
        <a href="/login">Login</a>
        <a href="/register">Register</a>
        <a href="/dashboard">Dashboard</a>
      </div>
      <div class="hero">
        <h1>FitMentor AI</h1>
        <p>Your Trainer. Your Nutritionist. Your Gym Buddy.</p>
        <p>Track workouts, get nutrition guidance, and plan your fitness journey with a simple student-friendly application.</p>
        <a class="button" href="/register">Get Started</a>
      </div>
    </div>
  </body>
</html>
